# App
APP_PORT=8080

# Database (or set DATABASE_URL to override)
DB_HOST=localhost
DB_PORT=5432
DB_USER=portfolio
DB_PASSWORD=portfolio
DB_NAME=portfolio
DB_SSLMODE=disable
# DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable

# Auth
JWT_SECRET=change-me-in-production
JWT_TTL=24h
ADMIN_USER=admin
ADMIN_PASS=admin123

# S3 / MinIO
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=portfolio
S3_USE_SSL=false
S3_PUBLIC_URL=http://localhost:9000/portfolio

# CORS
CORS_ORIGINS=http://localhost:9999,http://localhost:5173